# Server
PORT=8000
RELOAD=0

# Upstream tuning
REQUEST_TIMEOUT=25
RETRY_ATTEMPTS=3
RETRY_BACKOFF=0.5
DOMAIN_TTL=300

# Filter tab IDs — only used when /subject/filter returns a working response.
# Default catalogs fall back to /home sections automatically, so these being
# wrong doesn't break /movies etc. (they just use home_fallback instead).
# To probe: curl "http://localhost:8000/api/tabs?min_id=1&max_id=20"
TAB_MOVIES=2
TAB_TV=5
TAB_ANIMATION=8

# Catalog indexer
CATALOG_DB=catalog.db
CATALOG_REFRESH_INTERVAL=21600
CATALOG_MAX_PAGES_PER_KEYWORD=50

# Enrichment
ENRICH_RATE_LIMIT=0.2
ENRICH_BATCH_SIZE=20